{
  "name": "gabriel-sys",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/generate-search-index.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-og-image.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-search-index.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-og-image.mjs",
    "build": "next build && npm run exemplos:build && node scripts/juntar-exemplos.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "check": "npm run lint && npm run test && npm run exemplos:test && npm run build && npm run exemplos:verificar",
    "postbuild": "node scripts/verify-export.mjs && node scripts/verificar-saida.mjs",
    "imagens": "node scripts/imagens.mjs",
    "marca": "node scripts/marca.mjs",
    "e2e": "playwright test",
    "exemplos:instalar": "npm ci --prefix exemplos-sites --no-audit --no-fund",
    "exemplos:build": "npm --prefix exemplos-sites run build",
    "exemplos:test": "npm --prefix exemplos-sites test",
    "material:link": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/material-link.mjs",
    "material:codigo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/material-codigo.mjs",
    "test:cloudflare": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/testar-cloudflare.mjs",
    "previa": "WRANGLER_SEND_METRICS=false wrangler pages dev out --ip 127.0.0.1 --port 8788",
    "exemplos:verificar": "npm --prefix exemplos-sites run verificar:dist && npm --prefix exemplos-sites run verificar:creditos && npm --prefix exemplos-sites run verificar:navegador && npm --prefix exemplos-sites run verificar:interacao"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "gray-matter": "^4.0.3",
    "next": "16.4.5",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "axe-core": "4.13.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.5",
    "lighthouse": "13.5.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "4.157.0"
  }
}
