---
// Página de erro: link quebrado ou demo removido. Volta para a vitrine.
import Base from '../layouts/Base.astro';
import BotaoWhats from '../components/BotaoWhats.astro';
import { HOME } from '../data/home.ts';
---
<Base
  titulo="Página não encontrada"
  descricao={HOME.descricao}
  caminho="/404"
  imagemOg="/img/og/alimentacao.jpg"
  imagemAlt={HOME.titulo}
  nomeSite={HOME.titulo}
  tema="tema-home"
  corTema="#F7F5F0"
>
  <main id="conteudo" class="wrap erro">
    <h1>Esta página não existe</h1>
    <p>O endereço pode estar errado ou o demo foi tirado do ar. Os sete modelos continuam na vitrine.</p>
    <a class="botao" href="/">Ver os modelos</a>
    <BotaoWhats rotuloDemo={HOME.rotuloWhats} texto={HOME.botao} variante="contorno" principal />
  </main>
</Base>

<style is:global>
  .tema-home { --bg: #F7F5F0; --surface: #FFFFFF; --ink: #141414; --muted: #5E5A52; --primary: #1D6B45; --on-primary: #FFFFFF; }
</style>
<style>
  .erro { display: grid; gap: 1.25rem; justify-items: start; padding-block: 5rem; }
  h1 { font-size: clamp(2.2rem, 8vw, 4rem); line-height: 1; letter-spacing: -.02em; }
  p { max-width: 42ch; color: var(--muted); font-size: 1.1rem; }
</style>
