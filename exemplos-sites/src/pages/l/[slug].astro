---
// Rota de lead: lê src/data/leads/<slug>.ts (mesmo formato de um nicho + nichoBase) e usa o
// layout do nicho-base. O Astro gera dist/l/<slug>/; o build da raiz move para /para/<slug>/
// (scripts/juntar-exemplos.mjs). Fora de qualquer menu; noindex como todas as páginas.
import type { GetStaticPaths } from 'astro';
import type { Lead } from '../../data/tipos.ts';
import Alimentacao from '../../components/nichos/Alimentacao.astro';
import Beleza from '../../components/nichos/Beleza.astro';
import Cabeleireiro from '../../components/nichos/Cabeleireiro.astro';
import Saude from '../../components/nichos/Saude.astro';
import Fitness from '../../components/nichos/Fitness.astro';
import Loja from '../../components/nichos/Loja.astro';
import Servicos from '../../components/nichos/Servicos.astro';

export const getStaticPaths = (() => {
  const arquivos = import.meta.glob<{ default: Lead }>('../../data/leads/*.ts', { eager: true });
  return Object.entries(arquivos).map(([caminho, mod]) => ({
    params: { slug: caminho.split('/').pop()!.replace(/\.ts$/, '') },
    props: { lead: mod.default },
  }));
}) satisfies GetStaticPaths;

const { lead } = Astro.props as { lead: Lead };
const caminho = `/para/${Astro.params.slug}/`;
const PAGINAS = { alimentacao: Alimentacao, beleza: Beleza, cabeleireiro: Cabeleireiro, saude: Saude, fitness: Fitness, loja: Loja, servicos: Servicos };
const Pagina = PAGINAS[lead.nichoBase] as any;
---
<Pagina dados={lead} caminho={caminho} />
