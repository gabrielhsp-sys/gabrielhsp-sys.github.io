---
// Depoimentos de exemplo: cada um leva o selo "Exemplo" visível. Lista vazia = nada renderiza
// (o nicho de saúde não tem depoimento de paciente).
import type { Depoimento } from '../data/tipos.ts';

interface Props { lista: Depoimento[]; titulo?: string }
const { lista, titulo = 'Quem já é cliente' } = Astro.props;
---
{lista.length > 0 && (
  <section class="depoimentos" aria-labelledby="dep-titulo">
    <div class="wrap">
      <h2 id="dep-titulo" class="depoimentos__titulo">{titulo}</h2>
      <p class="depoimentos__aviso">Depoimentos de exemplo, escritos para este demo.</p>
      <ul role="list" class="depoimentos__lista">
        {lista.map((d) => (
          <li>
            <figure>
              <span class="selo-exemplo">Exemplo</span>
              <blockquote><p>“{d.texto}”</p></blockquote>
              <figcaption><strong>{d.autor}</strong>, {d.contexto}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .depoimentos { padding-block: var(--secao-y, 4rem); }
  .depoimentos__titulo { font-family: var(--font-titulo); font-size: var(--h2, 2rem); line-height: 1.1; }
  .depoimentos__aviso { margin-top: .5rem; color: var(--muted); font-size: .9rem; }
  .depoimentos__lista { display: grid; gap: 1rem; margin-top: 1.5rem; }
  @media (min-width: 48rem) { .depoimentos__lista { grid-template-columns: 1fr 1fr; } }
  .depoimentos figure { display: grid; gap: .75rem; justify-items: start; padding: 1.25rem; border-radius: var(--raio-cartao, 0); background: var(--surface); }
  .depoimentos blockquote { margin: 0; font-size: 1.1rem; }
  .depoimentos figcaption { color: var(--muted); font-size: .95rem; }
</style>
