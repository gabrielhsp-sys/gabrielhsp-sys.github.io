---
// Página do nicho SERVIÇOS (identidade: oficina organizada; petróleo, concreto e amarelo de
// sinalização; Chakra Petch + Public Sans; faixa zebrada). Todo texto vem de `dados`.
import '@fontsource/chakra-petch/latin-600.css';
import '@fontsource/chakra-petch/latin-700.css';
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-600.css';
import Base from '../../layouts/Base.astro';
import Foto from '../Foto.astro';
import BotaoWhats from '../BotaoWhats.astro';
import Orcamento from '../Orcamento.astro';
import Rodape from '../Rodape.astro';
import Icone from '../Icone.astro';
import type { DadosServicos } from '../../data/tipos.ts';
import { formatarPreco } from '../../lib/mensagens.ts';
import { imagemOg, tituloPagina } from '../../lib/paginas.ts';

interface Props { dados: DadosServicos; caminho: string }
const { dados: d, caminho } = Astro.props;
const reais = (c: number) => formatarPreco(c).replace(',00', '');
const fotosOficina = ['servicos/motor', 'servicos/pneu', 'servicos/chave'];
---
<Base
  titulo={tituloPagina(d)}
  descricao={d.negocio.descricao}
  caminho={caminho}
  imagemOg={imagemOg(d.hero.foto)}
  imagemAlt={d.negocio.resumo}
  nomeSite={d.negocio.resumo}
  tema="tema-prado"
  corTema="#12434F"
  rotuloDemo={d.rotulo}
>
  <main id="conteudo">
    <section class="hero">
      <div class="hero__grade wrap">
        <div class="hero__texto">
          <p class="marca">{d.negocio.nome}</p>
          <h1>{d.hero.titulo}</h1>
          <p class="hero__lead">{d.hero.texto}</p>
          <BotaoWhats rotuloDemo={d.rotulo} texto={d.botaoPrincipal} principal />
        </div>
        <div class="hero__foto"><Foto chave={d.hero.foto} sizes="(min-width: 56rem) 45vw, 100vw" prioridade /></div>
      </div>
      <div class="zebra" aria-hidden="true"></div>
    </section>

    <section class="servicos wrap" aria-labelledby="serv-t">
      <h2 id="serv-t" class="titulo">{d.servicos.titulo}</h2>
      <ul role="list" class="servicos__grade">
        {d.servicos.lista.map((s) => (
          <li class="servico">
            <h3><Icone nome={s.icone} /> {s.nome}</h3>
            <p class="servico__preco">a partir de <strong>{reais(s.aPartirDe)}</strong></p>
            <p class="servico__desc">{s.descricao}</p>
            <a class="servico__orcar" href="#orcamento" data-orcar={s.nome}>Orçar {s.nome.toLowerCase()}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="orc">
      <div class="wrap orc__grade">
        <div class="orc__form">
          <Orcamento titulo={d.orcamento.titulo} texto={d.orcamento.texto} servicos={d.servicos.lista.map((s) => s.nome)} quando={d.orcamento.quando} negocio={d.negocio.nome} rotuloDemo={d.rotulo} botaoTexto={d.botaoPrincipal} />
        </div>
        <div class="orc__lado">
          <h2 class="titulo-p">{d.garantias.titulo}</h2>
          <ul role="list" class="garantias">
            {d.garantias.lista.map((g) => <li><Icone nome="check" /> {g}</li>)}
          </ul>
          <div class="oficina">
            {fotosOficina.map((f) => <div><Foto chave={f} sizes="(min-width: 56rem) 15vw, 33vw" /></div>)}
          </div>
        </div>
      </div>
    </section>

    <section class="area wrap" aria-labelledby="area-t">
      <h2 id="area-t" class="titulo">{d.area.titulo}</h2>
      <p class="area__texto">{d.area.texto}</p>
      <ul role="list" class="area__cidades">
        {d.area.cidades.map((c, i) => <li class:list={[i === 0 && 'area__sede']}><Icone nome="map-pin" /> {c}</li>)}
      </ul>
    </section>
    {/* Sem depoimentos: nenhum depoimento inventado no site (prompt de 2026-11-19, tarefa 5). */}
  </main>

  <Rodape dados={d} />
</Base>

<script>
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLElement>('[data-orcar]');
    if (a) document.dispatchEvent(new CustomEvent('orcamento:servico', { detail: a.dataset.orcar }));
  });
</script>

<style is:global>
  .tema-prado {
    --bg: #ECEFF0; --surface: #FFFFFF; --ink: #0E1C22; --muted: #4A5A61;
    --petrol: #12434F; --primary: #F5C400; --on-primary: #0E1C22;
    --font-titulo: 'Chakra Petch', 'Arial Narrow', sans-serif; --font-texto: 'Public Sans', system-ui, sans-serif;
    --raio-botao: 4px; --raio-chip: 4px; --raio-cartao: 4px; --raio-campo: 4px; --peso-botao: 700;
    --h2: clamp(2rem, 6vw, 2.8rem);
    --chip-borda: #4A5A61; --chip-ativo-bg: #12434F; --chip-ativo-ink: #FFFFFF; --campo-borda: #4A5A61;
    --rodape-bg: #12434F; --rodape-ink: #ECEFF0; --selo-bg: #12434F; --selo-ink: #FFFFFF;
    --foco: #12434F;
  }
  .tema-prado .botao { box-shadow: 0 3px 0 #0E1C22; }
  .tema-prado .rodape { --foco: #F5C400; }
</style>

<style>
  .titulo { font-family: var(--font-titulo); font-weight: 700; font-size: var(--h2); line-height: 1.05; text-transform: uppercase; letter-spacing: .01em; margin-bottom: 1.25rem; }
  .titulo-p { font-family: var(--font-titulo); font-weight: 700; font-size: 1.5rem; text-transform: uppercase; margin-bottom: 1rem; }

  .hero { background: var(--petrol); color: #ECEFF0; --foco: #F5C400; }
  .hero__grade { display: grid; gap: 2rem; padding-block: 2.5rem 3rem; }
  .marca { font-family: var(--font-titulo); font-weight: 600; color: var(--primary); letter-spacing: .02em; }
  .hero h1 { font-family: var(--font-titulo); font-weight: 700; font-size: clamp(2.6rem, 11vw, 4.8rem); line-height: .98; text-transform: uppercase; margin-block: .5rem 1rem; max-width: 12ch; }
  .hero__lead { max-width: 36ch; font-size: 1.1rem; margin-bottom: 1.5rem; }
  .hero__foto :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--raio-cartao); border: 3px solid var(--primary); }
  @media (min-width: 56rem) { .hero__grade { grid-template-columns: 1fr 1fr; align-items: center; padding-block: 3.5rem 4rem; } }
  .zebra { height: 14px; background: repeating-linear-gradient(-45deg, var(--primary) 0 14px, var(--ink) 14px 28px); }

  .servicos { padding-block: 3.5rem; }
  /* Ficha técnica: linhas numa folha só, separadas por filete, em vez de cartões iguais. */
  .servicos__grade { display: grid; background: var(--surface); border-radius: var(--raio-cartao); padding-inline: 1.25rem; }
  @media (min-width: 56rem) { .servicos__grade { grid-template-columns: 1fr 1fr; column-gap: 3rem; } }
  .servico { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'n p' 'd d' 'o o'; gap: .2rem 1rem; padding-block: 1.1rem; border-bottom: 1px solid #d3dadc; }
  .servico h3 { grid-area: n; display: flex; align-items: center; gap: .5rem; font-family: var(--font-titulo); font-weight: 700; font-size: 1.2rem; text-transform: uppercase; }
  .servico h3 :global(.icone) { width: 1.4rem; height: 1.4rem; color: var(--petrol); }
  .servico__preco { grid-area: p; text-align: right; font-size: .85rem; color: var(--muted); line-height: 1.1; }
  .servico__preco strong { display: block; font-family: var(--font-titulo); font-size: 1.3rem; color: var(--ink); }
  .servico__desc { grid-area: d; color: var(--muted); }
  .servico__orcar { grid-area: o; justify-self: start; display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; color: var(--petrol); text-underline-offset: 3px; }

  .orc { background: var(--surface); padding-block: 3.5rem; border-block: 1px solid #cfd6d9; }
  .orc__grade { display: grid; gap: 3rem; }
  @media (min-width: 56rem) { .orc__grade { grid-template-columns: 1.2fr 1fr; align-items: start; } }
  .garantias { display: grid; gap: .75rem; margin-bottom: 1.5rem; }
  .garantias li { display: flex; gap: .6rem; align-items: center; font-weight: 600; }
  .garantias :global(.icone) { flex: none; padding: .2rem; width: 1.6rem; height: 1.6rem; background: var(--primary); border-radius: var(--raio-cartao); }
  .oficina { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
  .oficina :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--raio-cartao); }

  .area { padding-block: 3.5rem 1rem; }
  .area__texto { max-width: 46ch; margin-bottom: 1.25rem; }
  .area__cidades { display: flex; flex-wrap: wrap; gap: .6rem; }
  .area__cidades li { display: flex; align-items: center; gap: .35rem; padding: .5rem .9rem; background: var(--surface); border: 1.5px solid #b7c2c6; border-radius: var(--raio-chip); font-weight: 600; }
  .area__sede { background: var(--petrol) !important; color: #fff; border-color: var(--petrol) !important; }
</style>
