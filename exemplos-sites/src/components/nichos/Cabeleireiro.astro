---
// Página do nicho CABELEIREIRO (identidade: placa pintada de barbearia; grafite, creme, tijolo
// e latão; Bebas Neue + Archivo; cantos retos e filete duplo). Todo texto vem de `dados`.
import '@fontsource/bebas-neue/latin-400.css';
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-600.css';
import Base from '../../layouts/Base.astro';
import Foto from '../Foto.astro';
import BotaoWhats from '../BotaoWhats.astro';
import Agenda from '../Agenda.astro';
import Rodape from '../Rodape.astro';
import type { DadosCabeleireiro } from '../../data/tipos.ts';
import { formatarPreco } from '../../lib/mensagens.ts';
import { imagemOg, tituloPagina } from '../../lib/paginas.ts';

interface Props { dados: DadosCabeleireiro; caminho: string }
const { dados: d, caminho } = Astro.props;
const reais = (c: number) => formatarPreco(c).replace(',00', '');
const iniciais = (nome: string) => nome.split(' ').map((p) => p[0]).slice(0, 2).join('');
---
<Base
  titulo={tituloPagina(d)}
  descricao={d.negocio.descricao}
  caminho={caminho}
  imagemOg={imagemOg(d.hero.foto)}
  imagemAlt={d.negocio.resumo}
  nomeSite={d.negocio.resumo}
  tema="tema-navalha"
  corTema="#141516"
  rotuloDemo={d.rotulo}
>
  <main id="conteudo">
    <section class="hero">
      <div class="hero__fundo"><Foto chave={d.hero.foto} sizes="100vw" prioridade alt="" /></div>
      <div class="placa">
        <h1>{d.hero.titulo}</h1>
        <p class="placa__texto">{d.hero.texto}</p>
        <BotaoWhats rotuloDemo={d.rotulo} texto={d.botaoPrincipal} principal />
      </div>
    </section>

    <section class="cortes wrap" aria-labelledby="cortes-t">
      <h2 id="cortes-t" class="titulo">{d.cortes.titulo}</h2>
      <ul role="list" class="cortes__grade">
        {d.cortes.lista.map((c) => (
          <li class="corte">
            <div class="corte__foto"><Foto chave={c.foto} sizes="(min-width: 56rem) 25vw, 50vw" /></div>
            <p class="corte__nome">{c.nome}</p>
            <p class="corte__preco">{reais(c.preco)}</p>
            <p class="corte__dur">{c.duracaoMin} min</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="planos" aria-labelledby="planos-t">
      <div class="wrap">
        <h2 id="planos-t" class="titulo">{d.planos.titulo}</h2>
        <p class="planos__texto">{d.planos.texto}</p>
        <ul role="list" class="planos__lista">
          {d.planos.lista.map((p) => (
            <li class:list={['plano', p.destaque && 'plano--destaque']}>
              <p class="plano__nome">{p.nome}</p>
              <ul role="list" class="plano__inclui">{p.inclui.map((i) => <li>{i}</li>)}</ul>
              <p class="plano__preco">{reais(p.preco)} <span>{p.periodo}</span></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="time wrap" aria-labelledby="time-t">
      <h2 id="time-t" class="titulo">{d.barbeiros.titulo}</h2>
      <ul role="list" class="time__lista">
        {d.barbeiros.lista.map((b) => (
          <li>
            <span class="time__mono" aria-hidden="true">{iniciais(b.nome)}</span>
            <p class="time__nome">{b.nome}</p>
            <p class="time__detalhe">{b.detalhe}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="marcar">
      <div class="wrap marcar__caixa">
        <Agenda config={d.agenda} servicos={d.cortes.lista.map((c) => c.nome)} negocio={d.negocio.nome} rotuloDemo={d.rotulo} botaoTexto={d.botaoPrincipal} rotuloProfissional="Barbeiro" />
      </div>
    </section>
    {/* Sem depoimentos: nenhum depoimento inventado no site (prompt de 2026-11-19, tarefa 5). */}
  </main>

  <Rodape dados={d} />
</Base>

<style is:global>
  .tema-navalha {
    --bg: #141516; --surface: #1E2022; --ink: #EEE5D1; --muted: #A9A194;
    --primary: #B5382A; --on-primary: #FFFFFF; --brass: #C9A15B;
    --font-titulo: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
    --font-texto: 'Archivo', system-ui, sans-serif;
    --raio-botao: 0; --raio-chip: 0; --raio-cartao: 0; --raio-campo: 0;
    --h2: clamp(2.6rem, 9vw, 4rem); --peso-botao: 600;
    --chip-borda: #5a554c; --chip-ativo-bg: #C9A15B; --chip-ativo-ink: #141516;
    --rodape-bg: #0d0e0f; --rodape-ink: #EEE5D1;
    --selo-bg: #C9A15B; --selo-ink: #141516; --foco: #C9A15B;
    --linha: #3a3833;
  }
  .tema-navalha .depoimentos__titulo, .tema-navalha .agenda__titulo, .tema-navalha .rodape__nome { letter-spacing: .02em; font-weight: 400; }
  .tema-navalha .agenda__num { background: var(--brass); color: var(--bg); }
</style>

<style>
  .titulo { font-family: var(--font-titulo); font-weight: 400; font-size: var(--h2); line-height: .95; letter-spacing: .02em; }

  .hero { position: relative; display: grid; place-items: center; min-height: min(88svh, 46rem); padding: 2.5rem var(--gutter); isolation: isolate; }
  .hero__fundo { position: absolute; inset: 0; z-index: -1; }
  .hero__fundo :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.6) brightness(.38); }
  .placa {
    width: min(100%, 34rem); text-align: center; padding: 2rem 1.25rem;
    border: 3px double var(--brass); outline: 1px solid var(--brass); outline-offset: 6px;
    background: rgb(20 21 22 / .72);
    display: grid; justify-items: center; gap: 1rem;
  }
  .placa h1 { font-family: var(--font-titulo); font-weight: 400; font-size: clamp(3.6rem, 19vw, 7.5rem); line-height: .85; letter-spacing: .03em; }
  .placa__texto { max-width: 30ch; color: var(--ink); }
  .hero::after {
    content: ''; position: absolute; inset: auto 0 0 0; height: 10px;
    background: repeating-linear-gradient(90deg, var(--brass) 0 14px, transparent 14px 22px);
  }

  .cortes { padding-block: 4rem 3rem; }
  .cortes__grade { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1rem; margin-top: 1.5rem; }
  @media (min-width: 56rem) { .cortes__grade { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .corte { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'f f' 'n p' 'd p'; gap: 0 .5rem; }
  .corte__foto { grid-area: f; margin-bottom: .75rem; border: 1px solid var(--brass); padding: 4px; }
  .corte__foto :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .corte__nome { grid-area: n; font-weight: 600; line-height: 1.2; }
  .corte__dur { grid-area: d; color: var(--muted); font-size: .9rem; }
  .corte__preco { grid-area: p; font-family: var(--font-titulo); font-size: clamp(2rem, 8vw, 2.6rem); line-height: 1; color: var(--brass); }

  .planos { background: var(--ink); color: var(--bg); padding-block: 4rem; }
  .planos__texto { margin-block: .5rem 2rem; max-width: 40ch; }
  .planos__lista { display: grid; gap: 0; border-top: 2px solid var(--bg); }
  .plano { display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'n p' 'i i'; gap: .5rem 1rem; padding-block: 1.25rem; border-bottom: 2px solid var(--bg); }
  .plano--destaque { background: var(--bg); color: var(--ink); padding-inline: 1rem; border-bottom-color: var(--bg); }
  .plano__nome { grid-area: n; font-family: var(--font-titulo); font-size: 2rem; line-height: 1; letter-spacing: .02em; }
  .plano__preco { grid-area: p; text-align: right; font-family: var(--font-titulo); font-size: 2rem; line-height: 1; }
  .plano__preco span { display: block; font-family: var(--font-texto); font-size: .8rem; }
  .plano__inclui { grid-area: i; display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; font-size: .95rem; }
  .plano__inclui li::before { content: '✓ '; color: var(--primary); font-weight: 700; }
  .plano--destaque .plano__inclui li::before { color: var(--brass); }
  @media (min-width: 56rem) { .plano { grid-template-columns: 14rem 1fr auto; grid-template-areas: 'n i p'; align-items: center; } }

  .time { padding-block: 4rem 2rem; }
  .time__lista { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .time__mono { display: grid; place-items: center; width: 4rem; height: 4rem; border: 1px solid var(--brass); font-family: var(--font-titulo); font-size: 1.8rem; color: var(--brass); margin-bottom: .6rem; }
  .time__nome { font-weight: 600; }
  .time__detalhe { color: var(--muted); font-size: .92rem; }

  .marcar { padding-block: 2rem 4rem; }
  .marcar__caixa { border: 3px double var(--brass); padding: 1.5rem; }
</style>
