---
// Página do nicho SAÚDE (identidade: sóbria e informativa; verde-petróleo; Figtree).
// Regras: sem antes/depois, sem promessa de resultado, sem depoimento de paciente, sem rosto
// em close. Todo texto vem de `dados`.
import '@fontsource/figtree/latin-400.css';
import '@fontsource/figtree/latin-600.css';
import '@fontsource/figtree/latin-700.css';
import Base from '../../layouts/Base.astro';
import Foto from '../Foto.astro';
import BotaoWhats from '../BotaoWhats.astro';
import Rodape from '../Rodape.astro';
import Icone from '../Icone.astro';
import type { DadosSaude } from '../../data/tipos.ts';
import { imagemOg, tituloPagina } from '../../lib/paginas.ts';

interface Props { dados: DadosSaude; caminho: string }
const { dados: d, caminho } = Astro.props;
// Ícone por posição da especialidade (decorativo; o nome é o que informa).
const icones = ['stethoscope', 'person-simple-run', 'brain', 'carrot', 'tooth', 'heartbeat'];
const iniciais = (nome: string) => nome.replace(/^Dr[a]?\.\s*/, '').split(' ').map((p) => p[0]).slice(0, 2).join('');
---
<Base
  titulo={tituloPagina(d)}
  descricao={d.negocio.descricao}
  caminho={caminho}
  imagemOg={imagemOg(d.hero.foto)}
  imagemAlt={d.negocio.resumo}
  nomeSite={d.negocio.resumo}
  tema="tema-vida"
  corTema="#0E6B63"
  rotuloDemo={d.rotulo}
>
  <header class="topo">
    <div class="wrap topo__linha">
      <p class="marca"><Icone nome="heartbeat" /> {d.negocio.nome}</p>
      <nav aria-label="Seções"><a href="#especialidades">{d.especialidades.titulo}</a><a href="#convenios">{d.convenios.titulo}</a><a href="#chegar">{d.comoChegar.titulo}</a></nav>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero wrap">
      <div class="hero__texto">
        <h1>{d.hero.titulo}</h1>
        <p class="hero__lead">{d.hero.texto}</p>
        <BotaoWhats rotuloDemo={d.rotulo} texto={d.botaoPrincipal} principal />
      </div>
      <div class="hero__lado">
        <div class="hero__foto"><Foto chave={d.hero.foto} sizes="(min-width: 56rem) 45vw, 100vw" prioridade /></div>
        <dl class="painel">
          <div>
            <dt><Icone nome="clock" /> Horário</dt>
            {d.horario.map((h) => <dd>{h.dias}: {h.horas}</dd>)}
          </div>
          <div>
            <dt><Icone nome="map-pin" /> Endereço</dt>
            <dd>{d.endereco.bairro}, {d.endereco.cidade} - {d.endereco.uf}</dd>
          </div>
          <div>
            <dt><Icone nome="check" /> Convênios</dt>
            <dd>{d.convenios.lista.length} opções, incluindo particular</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="esp" id="especialidades" aria-labelledby="esp-t">
      <div class="wrap">
        <h2 id="esp-t" class="titulo">{d.especialidades.titulo}</h2>
        <ul role="list" class="esp__lista">
          {d.especialidades.lista.map((e, i) => (
            <li>
              <span class="esp__icone"><Icone nome={icones[i % icones.length]} /></span>
              <div><h3>{e.nome}</h3><p>{e.descricao}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="equipe wrap" aria-labelledby="eq-t">
      <h2 id="eq-t" class="titulo">{d.equipe.titulo}</h2>
      <p class="aviso"><span class="selo-exemplo">Exemplo</span> {d.equipe.aviso}</p>
      <ul role="list" class="equipe__lista">
        {d.equipe.lista.map((p) => (
          <li>
            <span class="equipe__mono" aria-hidden="true">{iniciais(p.nome)}</span>
            <div>
              <p class="equipe__nome">{p.nome}</p>
              <p>{p.especialidade}</p>
              <p class="equipe__reg">{p.registro}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="conv" id="convenios" aria-labelledby="conv-t">
      <div class="wrap conv__grade">
        <div>
          <h2 id="conv-t" class="titulo">{d.convenios.titulo}</h2>
          <p class="aviso">{d.convenios.aviso}</p>
        </div>
        <ul role="list" class="conv__chips">{d.convenios.lista.map((c) => <li>{c}</li>)}</ul>
      </div>
    </section>

    <section class="chegar wrap" id="chegar" aria-labelledby="chegar-t">
      <div>
        <h2 id="chegar-t" class="titulo">{d.comoChegar.titulo}</h2>
        <p class="chegar__texto">{d.comoChegar.texto}</p>
        <p class="chegar__ref">{d.endereco.referencia}</p>
        <ul role="list" class="chegar__pontos">
          {d.comoChegar.pontos.map((p) => <li><Icone nome="check" /> {p}</li>)}
        </ul>
        <BotaoWhats rotuloDemo={d.rotulo} texto={d.botaoPrincipal} variante="contorno" />
      </div>
      <div class="ambiente" aria-label={d.ambiente.titulo} role="group">
        {d.ambiente.fotos.map((f) => <div class="ambiente__foto"><Foto chave={f} sizes="(min-width: 56rem) 25vw, 50vw" /></div>)}
      </div>
    </section>
  </main>

  <Rodape dados={d} />
</Base>

<style is:global>
  .tema-vida {
    --bg: #F3F6F4; --surface: #FFFFFF; --ink: #13302C; --muted: #4D6661;
    --primary: #0E6B63; --on-primary: #FFFFFF; --tint: #DCE9E3;
    --font-titulo: 'Figtree', system-ui, sans-serif; --font-texto: 'Figtree', system-ui, sans-serif;
    --raio-botao: 12px; --raio-chip: 999px; --raio-cartao: 12px; --raio-campo: 8px;
    --h2: clamp(1.8rem, 5vw, 2.4rem); --peso-botao: 600;
    --rodape-bg: #0E3B37; --rodape-ink: #F3F6F4;
    --selo-bg: #13302C; --selo-ink: #FFFFFF;
  }
  .tema-vida .rodape .botao { background: #F3F6F4; color: #0E3B37; }
</style>

<style>
  .titulo { font-weight: 700; font-size: var(--h2); line-height: 1.15; letter-spacing: -.015em; }
  .aviso { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-top: .5rem; color: var(--muted); font-size: .92rem; }

  .topo { background: var(--surface); border-bottom: 1px solid #d5e0db; }
  .topo__linha { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .25rem 1.5rem; padding-block: .6rem; }
  .marca { display: flex; align-items: center; gap: .4rem; font-weight: 700; color: var(--primary); }
  .topo nav { display: flex; gap: 1.25rem; font-size: .92rem; }
  .topo nav a { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: none; }
  @media (max-width: 40rem) { .topo nav { display: none; } }

  .hero { display: grid; gap: 2rem; padding-block: 2.5rem 3.5rem; }
  .hero h1 { font-size: clamp(2.1rem, 7vw, 3.4rem); line-height: 1.08; letter-spacing: -.02em; font-weight: 700; max-width: 18ch; }
  .hero__lead { margin-block: 1rem 1.75rem; font-size: 1.12rem; color: var(--muted); max-width: 42ch; }
  .hero__lado { display: grid; }
  .hero__foto :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--raio-cartao); }
  .painel { display: grid; gap: 1rem; margin: -2.5rem 1rem 0; position: relative; padding: 1.25rem; background: var(--surface); border: 1px solid #d5e0db; border-radius: var(--raio-cartao); box-shadow: 0 12px 30px rgb(19 48 44 / .12); }
  .painel dt { display: flex; align-items: center; gap: .4rem; font-weight: 600; color: var(--primary); }
  .painel dd { margin-left: 1.65rem; }
  @media (min-width: 56rem) {
    .hero { grid-template-columns: 1fr 1.05fr; align-items: center; }
    .painel { margin: -4rem 0 0 -3rem; width: 80%; }
  }

  .esp { background: var(--surface); padding-block: 4rem; }
  .esp__lista { display: grid; gap: 1.5rem 2.5rem; margin-top: 2rem; }
  @media (min-width: 48rem) { .esp__lista { grid-template-columns: 1fr 1fr; } }
  .esp__lista li { display: flex; gap: 1rem; align-items: flex-start; }
  .esp__icone { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; border-radius: 50%; background: var(--tint); color: var(--primary); }
  .esp__icone :global(.icone) { width: 1.5rem; height: 1.5rem; }
  .esp h3 { font-size: 1.15rem; font-weight: 600; }
  .esp p { color: var(--muted); }

  .equipe { padding-block: 4rem; }
  .equipe__lista { display: grid; gap: 1rem; margin-top: 1.75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .equipe__lista li { display: flex; gap: 1rem; align-items: center; padding: 1rem; border: 1px solid #d5e0db; border-radius: var(--raio-cartao); background: var(--surface); }
  .equipe__mono { display: grid; place-items: center; flex: none; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--primary); color: #fff; font-weight: 700; }
  .equipe__nome { font-weight: 600; }
  .equipe__reg { color: var(--muted); font-size: .88rem; font-variant-numeric: tabular-nums; }

  .conv { background: var(--tint); padding-block: 3.5rem; }
  .conv__grade { display: grid; gap: 1.5rem; }
  @media (min-width: 56rem) { .conv__grade { grid-template-columns: 1fr 1.4fr; align-items: center; } }
  .conv__chips { display: flex; flex-wrap: wrap; gap: .6rem; }
  .conv__chips li { padding: .55rem 1rem; border-radius: 999px; background: var(--surface); font-weight: 600; }

  .chegar { display: grid; gap: 2.5rem; padding-block: 4rem; }
  .chegar__texto { margin-top: .75rem; font-size: 1.1rem; }
  .chegar__ref { color: var(--muted); }
  .chegar__pontos { display: grid; gap: .5rem; margin-block: 1.25rem 1.75rem; }
  .chegar__pontos li { display: flex; align-items: center; gap: .5rem; }
  .chegar__pontos :global(.icone) { color: var(--primary); }
  .ambiente { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .ambiente__foto:first-child { grid-column: span 2; }
  .ambiente__foto :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--raio-cartao); }
  .ambiente__foto:first-child :global(img) { aspect-ratio: 16 / 9; }
  @media (min-width: 56rem) { .chegar { grid-template-columns: 1fr 1.2fr; align-items: center; } }
</style>
